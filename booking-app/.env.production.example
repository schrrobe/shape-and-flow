# Copy this file to booking-app/.env.production on the server and fill it in.
#
#   cp booking-app/.env.production.example booking-app/.env.production
#   chmod 600 booking-app/.env.production
#
# It is git-ignored, and it is the only file in the deployment that holds a secret.
# docker-compose.prod.yml reads it twice, for two different jobs:
#
#   * `--env-file` — the `${...}` substitutions in the compose file itself
#   * `env_file:`  — the variables handed to the api, worker and migrate containers
#
# so a variable that belongs to only one of those still lives here, in one place.
#
# ┌───────────────────────────────────────────────────────────────────────────┐
# │ THE API WILL REFUSE TO START WITH THIS FILE AS WRITTEN.                    │
# │                                                                           │
# │ NODE_ENV=production rejects `fake` for email and SMS, and the real Resend  │
# │ and Twilio adapters are Task 3.4 and are not written yet — selecting them  │
# │ throws a named error at bootstrap rather than quietly sending nothing.     │
# │ Until 3.4 lands, a deployment can only run with NODE_ENV=development and   │
# │ the fakes, which is a staging environment, not a production one.           │
# └───────────────────────────────────────────────────────────────────────────┘

# ── the database container ───────────────────────────────────────────────────
#
# Read by compose to configure Postgres itself. They are not handed to the API,
# which reads DATABASE_URL below — the two must describe the same database.
POSTGRES_USER=booking
POSTGRES_PASSWORD=replace_me_with_a_long_random_string
POSTGRES_DB=booking

# ── which environment this file is ───────────────────────────────────────────
#
# Substituted into the compose project name, every container_name, and the env_file
# the containers read — the three things that would otherwise collide if a second
# environment ran on the same host. `production` is the default, so it may be left
# as-is here; a stage file sets `STACK_SUFFIX=stage` and is named `.env.stage`.
# The name of this file and the value below must agree: `.env.<suffix>`.
STACK_SUFFIX=production

# ── images and published ports ───────────────────────────────────────────────
#
# IMAGE_TAG names what is deployed and is what a rollback changes. `local` is what
# `docker compose build` produces; a release should use a git sha.
IMAGE_TAG=local
# Both bind to 127.0.0.1 only. The edge nginx is the only thing that reaches them.
API_PUBLISH_PORT=3001
WEB_PUBLISH_PORT=8080

# ── runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=production
# Ignored. docker-compose.prod.yml sets it per service, so one file can configure
# both processes without the risk of starting two APIs and no worker.
APP_ROLE=api
# Matches EXPOSE and the healthcheck in the API image.
PORT=3001
LOG_LEVEL=info
# Availability is polled on every date change a browsing customer makes and can
# dominate a day's log volume. A tenth is enough to see the shape of the traffic.
LOG_SAMPLE_RATE=0.1

# ── data stores ──────────────────────────────────────────────────────────────
#
# Host names are compose service names, reachable only from the compose network.
DATABASE_URL=postgresql://booking:replace_me_with_a_long_random_string@postgres:5432/booking?schema=public
REDIS_URL=redis://redis:6379
REDIS_QUEUE_PREFIX=bull

# ── tenancy ──────────────────────────────────────────────────────────────────
# The fallback tenant, used when a public request names no organizer at all —
# neither by the hostname it arrived on nor by ?organizer=.
DEFAULT_ORGANIZATION_SLUG=shape-and-flow

# Extra hostnames on which ?organizer=<slug> may choose the tenant. Comma
# separated, additive to the hosts of PUBLIC_WEB_ORIGIN and PUBLIC_API_ORIGIN.
# Organizer domains are registered through POST /api/office/domains and must NOT
# be listed here: a domain that is also central would let a link carrying a
# foreign ?organizer= pick a different tenant on that organizer's own address.
CENTRAL_HOSTNAMES=

# ── web origins ──────────────────────────────────────────────────────────────
#
# One origin: the bundle and the API are served from the same hostname, and
# PUBLIC_WEB_ORIGIN also allow-lists the Stripe success and cancel URLs, so a
# wrong value here makes every booking fail validation rather than redirect
# somewhere unexpected.
PUBLIC_WEB_ORIGIN=https://buchung.example.com
PUBLIC_API_ORIGIN=https://buchung.example.com

# ── feature flags ────────────────────────────────────────────────────────────
UNLEASH_URL=https://unleash.shapeandflow.de/api/
UNLEASH_BACKEND_TOKEN=backend_production_replace_me
# Public and read-only, but still scoped to the production environment.
UNLEASH_FRONTEND_TOKEN=frontend_production_replace_me
UNLEASH_ENVIRONMENT=production
UNLEASH_DEPLOYMENT=production

# ── payments ─────────────────────────────────────────────────────────────────
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_live_replace_me
# Not a secret, but still required: the office payments page gets it from the API rather
# than from the bundle, so one web image can serve any Stripe mode. Missing it, the API
# refuses to start whenever PAYMENT_PROVIDER is "stripe".
STRIPE_PUBLISHABLE_KEY=pk_live_replace_me
# From the Stripe dashboard's endpoint for https://buchung.example.com/api/webhooks/stripe.
# It is per endpoint, not per account: a new endpoint means a new secret.
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# From the Stripe *Connect* destination, pointed at
# https://buchung.example.com/api/webhooks/stripe/connect — account.updated and any charge
# made on a connected account. Stripe signs it with its own key, which is why it cannot
# share the endpoint above. Required: self-service organizer registration always onboards
# a new organizer through Stripe Connect, so this destination is live from the first
# registration onward, not once some later milestone is reached.
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_replace_me

# ── email ────────────────────────────────────────────────────────────────────
EMAIL_PROVIDER=resend
EMAIL_FROM_ADDRESS=buchung@example.com
EMAIL_FROM_NAME=Shape and Flow
RESEND_API_KEY=re_replace_me
RESEND_WEBHOOK_SECRET=whsec_replace_me

# ── sms ──────────────────────────────────────────────────────────────────────
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=AC_replace_me
TWILIO_AUTH_TOKEN=replace_me
TWILIO_FROM_NUMBER=+4915100000000
# Must be the exact public URL Twilio signs against.
TWILIO_STATUS_CALLBACK_URL=https://buchung.example.com/api/webhooks/twilio

# ── security ─────────────────────────────────────────────────────────────────
SESSION_COOKIE_NAME=sf_office_session
SESSION_IDLE_TTL_MINUTES=720
SESSION_ABSOLUTE_TTL_MINUTES=10080

# ── development affordances ──────────────────────────────────────────────────
#
# Both are refused outright when NODE_ENV=production. They are listed so the file
# stays a complete inventory of what the schema knows.
ENABLE_API_DOCS=false
ENABLE_TEST_SUPPORT=false

# ── worker ───────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=5
