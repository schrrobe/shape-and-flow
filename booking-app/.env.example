# Copy this file to booking-app/.env and fill in real values.
#
#   cp booking-app/.env.example booking-app/.env
#
# booking-app/.env is git-ignored and is the file the API and the worker read.
# Every variable below is validated at bootstrap by
# booking-app/apps/api/src/config/env.schema.ts; the process exits non-zero and
# names every offending variable if any of them is missing or malformed.
# A test asserts that this file and that schema declare the same key set, so a
# new variable cannot be introduced without being documented here.

# ── runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
# api | worker — asserted at bootstrap so an HTTP process can never silently
# start consuming queues, and vice versa.
APP_ROLE=api
PORT=3000
# fatal | error | warn | info | debug | trace
LOG_LEVEL=debug
# Share of GET /public/availability request lines that are written, 0 to 1. That
# endpoint is hit on every date change a browsing customer makes and can dominate
# a day's log volume; nothing else is ever sampled out. 1 logs everything.
LOG_SAMPLE_RATE=1

# ── data stores ──────────────────────────────────────────────────────────────
# Ports match booking-app/docker-compose.yml, not the Postgres/Redis defaults.
DATABASE_URL=postgresql://booking:booking@localhost:5433/booking?schema=public
DATABASE_POOL_SIZE=10
REDIS_URL=redis://localhost:6380
# Namespace for every BullMQ key. Change it to run two environments against one
# Redis; the integration suite overrides it so a test reset cannot touch these
# queues. Workers and the API must agree, or the workers consume nothing.
REDIS_QUEUE_PREFIX=bull

# ── tenancy ──────────────────────────────────────────────────────────────────
# Resolved once at bootstrap into the OrganizationContext provider. The
# organization id is never accepted from a request.
DEFAULT_ORGANIZATION_SLUG=shape-and-flow

# ── web origins ──────────────────────────────────────────────────────────────
# PUBLIC_WEB_ORIGIN also allow-lists the success/cancel URLs a booking request
# may pass to Stripe, so the redirect cannot be pointed at another host.
PUBLIC_WEB_ORIGIN=http://localhost:5173
PUBLIC_API_ORIGIN=http://localhost:3000

# ── payments ─────────────────────────────────────────────────────────────────
# fake | stripe — `fake` is refused when NODE_ENV=production.
PAYMENT_PROVIDER=fake
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# ── email ────────────────────────────────────────────────────────────────────
# fake | resend — `fake` is refused when NODE_ENV=production.
EMAIL_PROVIDER=fake
EMAIL_FROM_ADDRESS=buchung@example.com
EMAIL_FROM_NAME="Shape and Flow"
RESEND_API_KEY=re_replace_me
RESEND_WEBHOOK_SECRET=whsec_replace_me

# ── sms ──────────────────────────────────────────────────────────────────────
# fake | twilio — `fake` is refused when NODE_ENV=production.
SMS_PROVIDER=fake
TWILIO_ACCOUNT_SID=AC_replace_me
TWILIO_AUTH_TOKEN=replace_me
TWILIO_FROM_NUMBER=+4915100000000
# Must be the exact public URL Twilio will sign against.
TWILIO_STATUS_CALLBACK_URL=http://localhost:3000/api/webhooks/twilio

# ── security ─────────────────────────────────────────────────────────────────
SESSION_COOKIE_NAME=sf_office_session
SESSION_IDLE_TTL_MINUTES=720
SESSION_ABSOLUTE_TTL_MINUTES=10080

# ── development affordances ──────────────────────────────────────────────────
# Both are refused when NODE_ENV=production.
ENABLE_API_DOCS=true
ENABLE_TEST_SUPPORT=false

# ── worker ───────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=5
