.DS_Store
.tokensave/
.claude/settings.local.json

# dependencies
node_modules/

# generated code — recreated by `prisma generate` on install.
# The leading **/ matters: a pattern containing a middle separator is anchored
# to this file's directory, so a bare `src/generated/` would only ever match at
# the repository root.
**/src/generated/

# build output
dist/
build/
.vite/
.turbo/

# test and coverage output
coverage/
playwright-report/
test-results/

# secrets
.env
.env.local

# logs
*.log
