root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Markdown uses two trailing spaces as a hard line break, so trimming them
# would silently change rendered output.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
